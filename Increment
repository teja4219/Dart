import 'package:flutter/material.dart';
void main(){
  runApp(MyApp());
}
class MyApp extends StatefulWidget{
  State<MyApp> createState()=> _MyAppState();
}
class _MyAppState extends State<MyApp>{
  int c=0;
  double sizer = 50;
  Widget build(BuildContext context){
    return MaterialApp(
      home : Scaffold(
        appBar : AppBar(
          title : Text("Ststeful Widget Example",
                      style  : TextStyle(
                        fontWeight:FontWeight.w400,
                      ),
                   ),
          ),
        
        body : Center(
          child:
              Column(mainAxisAlignment:MainAxisAlignment.center,
                    children :[
                      Icon(
                        Icons.school,
                        size : sizer,
                        color : Colors.green,
                      
                      ),
                      
                      SizedBox(height:10),
                      
                      Text(
                        "Count : $c",
                        style : TextStyle(fontSize:20),
                      ),
                      
                      SizedBox(height:10),
                      
                      ElevatedButton(
                        onPressed:(){
                          setState(() {
                            c=c+10;
                            sizer++;
                          });
                        },
                        
                        child:Text("click to increase"),
                      ),
                      
                       ElevatedButton(
                        onPressed:(){
                          setState(() {
                            c--;
                            sizer--;
                          });
                        },
                        
                        child:Text("click to reduce"),
                      ),
                      
                    ],
                    
                    
                    ),
        
        ),
      ),
    );
  }
}
